# Directus connection
# URL for the Directus instance (used by the server-side proxy, not exposed to the browser)
DIRECTUS_URL=
# Static token for authenticating with Directus (used by the server-side proxy)
DIRECTUS_TOKEN=

# Build / deployment
# Set this if you need your site to be served from a sub-path (e.g. GitHub Pages).
VITE_BASE_PATH=/

# Node environment
NODE_ENV=production
