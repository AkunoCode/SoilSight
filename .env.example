# Frontend (Vite) environment variables
# Used by the client code (exposed in the built bundle).
# Replace placeholders with your Directus URL and a read-only/static token if used.
VITE_DIRECTUS_API_URL=YOUR_DIRECTUS_API_URL
VITE_DIRECTUS_BEARER_TOKEN=YOUR_DIRECTUS_BEARER_TOKEN

# Server / proxy environment variables
# These are used by the server-side API proxy (in `api/directus-proxy.js`) or
# by build-time config. Keep these private (do NOT commit secret values).
# Optional: URL for the internal Directus instance the server should talk to.
DIRECTUS_INTERNAL_URL=
# Optional: server-side Directus token used for internal API requests.
DIRECTUS_INTERNAL_TOKEN=

# Build / deployment
# Set this if you need your site to be served from a sub-path (e.g. GitHub Pages).
# Example: VITE_BASE_PATH=/SoilSight/
VITE_BASE_PATH=/

# Node environment (commonly set by your host during deployment)
# Values: `development` or `production` (default for many hosts is `production`).
NODE_ENV=production

# Notes:
# - Vite exposes `import.meta.env.VITE_*` to client code. Avoid putting secrets
#   in front-end vars unless they are intentionally public/static.
# - Server vars (without the `VITE_` prefix) are only available to server code
#   (e.g. the proxy) and should contain private tokens/URLs.